// App Store · Archive 버전 설정
// - Version(마케팅): CFBundleShortVersionString → Xcode에 1.0 으로 표시
// - Build(빌드): CFBundleVersion → Xcode에 (숫자) 로 표시
// Archive 할 때마다 Scripts/bump_build_number.sh 가 BUILD_NUMBER 를 1씩 올립니다.

MARKETING_VERSION = 1.0
BUILD_NUMBER = 32
CURRENT_PROJECT_VERSION = $(BUILD_NUMBER)
